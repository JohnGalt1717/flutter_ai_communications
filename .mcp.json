{
    "mcpServers": {
        "flutter_agent_lens": {
            "command": "flutter-agent-lens"
        },
        "flutter-skill": {
            "command": "bash",
            "args": [
                "-lc",
                "cd /Users/jameshancock/.pub-cache/hosted/pub.dev/flutter_skill-0.9.36 && dart run bin/server.dart"
            ]
        },
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest"
            ]
        },
        "markitdown": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-v",
                "./.markitdown:/local-directory",
                "mcp/markitdown"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ]
        }
    }
}