# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Package pubspec.lock files stay untracked; the workspace lockfile is committed.
packages/**/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
**/build/
/coverage/

# Generated Flutter test/native assets and Android compile output
**/unit_test_assets/
**/test_cache/
**/native_assets/
**/android/bin/

# Swift Package Manager
**/.build/
**/.swiftpm/

# Local Orchestration screenshots (may contain desktop contents)
.scratch/screen-proof/
